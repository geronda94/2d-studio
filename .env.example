# Copy to .env and fill locally / on the server. Never commit .env.
GEMINI_API_KEY=
GEMINI_PROJECT_KEY=
GEMINI_PROJECT_NUMBER=
GOOGLE_APPLICATION_CREDENTIALS=
FREESOUND_API_KEY=

# Auth (optional for local dev)
AUTH_MODE=off
ADMIN_EMAIL=
ADMIN_PASSWORD=
INTERNAL_API_TOKEN=

# Local Whisper STT (server: host.docker.internal; dev machine: http://127.0.0.1:8788)
STT_URL=http://host.docker.internal:8788
STT_KEY=local-whisper-key
